# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Used to build referral / invite links (join?ref=...). Falls back to
# https://YOURDOMAIN.com if unset, which produces broken invites.
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kashvimlm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=kashvimlm

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# MLM Business Rules & Default Parameters
DEFAULT_SPONSOR_ID=88767139
MINIMUM_QUALIFYING_BV=100
BINARY_MATCH_PERCENTAGE=10
TDS_DEDUCTION_PERCENTAGE=5
ADMIN_FEE_PERCENTAGE=5

# Email Service Configuration (Optional / Future Delivery)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password
