{
  "name": "kashvimlm-server",
  "version": "1.0.0",
  "description": "Enterprise MLM REST API backend for Kashvimlm with PostgreSQL, Node.js, Express and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx src/database/initDb.ts",
    "test:tree": "tsx --test src/modules/mlmTree/mlmTree.test.ts",
    "test:api": "tsx --test src/modules/mlmTree/mlmTree.api.test.ts",
    "test:placement": "tsx --test src/modules/mlmTree/binaryPlacement.test.ts",
    "test:prompt4": "tsx --test src/modules/mlmTree/binaryTree.test.ts",
    "test:prompt5": "tsx --test src/modules/commissionEngine/commission.test.ts",
    "test:prompt6": "tsx --test src/modules/auth/auth.test.ts",
    "test": "tsx --test src/modules/mlmTree/mlmTree.test.ts src/modules/mlmTree/mlmTree.api.test.ts src/modules/mlmTree/binaryPlacement.test.ts src/modules/mlmTree/binaryTree.test.ts src/modules/commissionEngine/commission.test.ts src/modules/auth/auth.test.ts"
  },
  "keywords": [
    "mlm",
    "binary-tree",
    "bv-engine",
    "commission",
    "kashvimlm",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "Kashvimlm Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
