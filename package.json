{
  "name": "kashvimlm",
  "private": true,
  "version": "0.0.0",
  "type": "module",

  "scripts": {
    "dev": "vite",
    "server": "npm run dev --prefix server",
    "server:dev": "npm run dev --prefix server",
    "backend": "npm run dev --prefix backend",
    "backend:db": "npm run db:start --prefix backend",
    "backend:all": "npm run dev:all --prefix backend",
    "build:api": "node scripts/build-api.js",
    "build": "node scripts/db-sync.js && npm run prisma:generate --prefix backend && npm run build:api && vite build",
    "vercel-build": "npm install --prefix backend && node scripts/db-sync.js && npm run prisma:generate --prefix backend && npm run build:api && vite build",
    "db:push": "npm run prisma:db:push --prefix backend",
    "db:push:prod": "npm run prisma:db:push --prefix backend",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:frontend": "node --test src/tests/frontend.test.js",
    "test:admin": "node --test src/tests/admin.test.js",
    "test:funding": "node --test src/tests/fundingPortal.test.js",
    "test:final": "node --test src/tests/final.test.js",
    "test": "npm test --prefix server",
    "test:binary": "npm run test:binary --prefix backend",
    "test:matching": "npm run test:matching --prefix backend",
    "test:commission-calc": "npm run test:commission-calc --prefix backend",
    "test:commission-eligibility": "npm run test:commission-eligibility --prefix backend",
    "test:commission-ledger": "npm run test:commission-ledger --prefix backend",
    "test:commission-posting": "npm run test:commission-posting --prefix backend",
    "test:commission-wallet": "npm run test:commission-wallet --prefix backend",
    "test:order-commission-lifecycle": "npm run test:order-commission-lifecycle --prefix backend",
    "test:commission-reversal": "npm run test:commission-reversal --prefix backend",
    "test:commission-api": "npm run test:commission-api --prefix backend",
    "test:commission-dashboard": "npm run test:commission-dashboard --prefix backend",
    "test:commission-security": "npm run test:commission-security --prefix backend",
    "test:commission-suite": "npm run test:commission-suite --prefix backend",
    "test:commission-reconciliation": "npm run test:commission-reconciliation --prefix backend",
    "test:tree": "npm run test:tree --prefix server",
    "test:api": "npm run test:api --prefix server",
    "db:init": "npm run db:init --prefix server"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.43.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
