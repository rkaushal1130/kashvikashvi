# Kashvi MLM Frontend Environment Configuration Template
# Copy this file to .env.local or configure in your deployment hosting (e.g. Vercel)

# Backend API Base URL
# For local development: http://localhost:5000/api
# For production (e.g., Render / Railway / AWS): https://api.kashvimlm.com/api
VITE_API_URL=http://localhost:5000/api

# Application Mode: development | production | staging
VITE_APP_ENV=development

# Optional Application Name
VITE_APP_NAME="Kashvi MLM Platform"
