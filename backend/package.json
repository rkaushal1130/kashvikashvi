{
  "name": "kashvimlm-backend",
  "version": "1.0.0",
  "description": "Backend foundation for Kashvimlm with Node.js, Express, TypeScript, and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:binary": "vitest run tests/binaryVolume.test.ts",
    "test:matching": "vitest run tests/matching.test.ts",
    "test:bb": "vitest run tests/bb.test.ts",
    "test:commission-calc": "vitest run tests/commissionCalculation.test.ts",
    "test:commission-eligibility": "vitest run tests/commissionEligibility.test.ts",
    "test:commission-ledger": "vitest run tests/commissionLedger.test.ts",
    "test:commission-posting": "vitest run tests/atomicCommissionPosting.test.ts",
    "test:commission-wallet": "vitest run tests/commissionWallet.test.ts",
    "test:order-commission-lifecycle": "vitest run tests/orderCommissionLifecycle.test.ts",
    "test:commission-reversal": "vitest run tests/commissionReversal.test.ts",
    "test:commission-api": "vitest run tests/commissionApi.test.ts",
    "test:commission-dashboard": "vitest run tests/commissionDashboard.test.ts",
    "test:commission-security": "vitest run tests/commissionSecurity.test.ts",
    "test:commission-suite": "vitest run tests/completeCommissionSuite.test.ts",
    "test:commission-reconciliation": "vitest run tests/commissionReconciliation.test.ts",
    "test:watch": "vitest",
    "test:runner": "tsx tests/runner.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "prisma",
    "zod",
    "jwt",
    "argon2",
    "pino"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "supertest": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
