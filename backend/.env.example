# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kashvimlm?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Corporate Banking & Treasury Funding Provider (RazorpayX / Cashfree / Mock)
FUNDING_PROVIDER=MOCK
FUNDING_PROVIDER_KEY_ID=rzp_test_your_key_id
FUNDING_PROVIDER_KEY_SECRET=your_key_secret_keep_secret
FUNDING_PROVIDER_WEBHOOK_SECRET=your_webhook_secret_min_32_chars
FUNDING_PROVIDER_ACCOUNT_NUMBER=2323230011223344

# Initial Super Admin Configuration (for database initialization / reset)
INITIAL_ADMIN_EMAIL=admin@kashvimlm.com
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_min_8_chars
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_PHONE="9876543210"
INITIAL_ADMIN_REFERRAL_CODE="KV-1001"

# Production Reset Safeguards (set to true only when performing deliberate reset)
CONFIRM_PRODUCTION_RESET=false
ENABLE_ADMIN_RESET_API=false

# Razorpay Checkout (Standard Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
