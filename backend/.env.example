# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kashvimlm?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Corporate Banking & Treasury Funding Provider (RazorpayX / Cashfree / Mock)
FUNDING_PROVIDER=MOCK
FUNDING_PROVIDER_KEY_ID=rzp_test_your_key_id
FUNDING_PROVIDER_KEY_SECRET=your_key_secret_keep_secret
FUNDING_PROVIDER_WEBHOOK_SECRET=your_webhook_secret_min_32_chars
FUNDING_PROVIDER_ACCOUNT_NUMBER=2323230011223344
